{
  "name": "terctl",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "error-check": "tsc --b && echo 'No TypeScript errors found'",
    "update:all": "npx npm-check-updates -u --dep prod && npm install",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "env -u GTK_PATH -u GIO_MODULE_DIR tauri dev",
    "release": "bash scripts/release.sh patch",
