{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TerCTL",
  "version": "1.0.1",
  "identifier": "com.terctl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TerCTL",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 21 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMTc4RjUwQkNEQzU3RjcKUldUM1Y5eThVSThYUDlGWVROclBsNklvNlBSS0twaFBZYUVqWFVnS3lYVlU2enZyVUx5cnlEbTkK",
      "endpoints": [
        "https://github.com/rakeshModak/terCTL/releases/latest/download/latest.json"
      ]
    }
  }
}
